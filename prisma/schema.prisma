// AIMAG ELECTRIC — production data model.
// Normalized B2B catalog: reference data (Category, Brand), core Product with
// media (ProductImage, ProductDocument), flexible EAV specs (Attribute,
// AttributeValue), inventory (Warehouse, Stock) and pricing (Price), plus the
// existing auth + quotes domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CUSTOMER
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  SENT
  WON
  LOST
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
}

/**
 * Immutable audit trail of significant admin/security actions.
 */
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entity     String // e.g. "Product", "Quote", "Auth"
  entityId   String?
  summary    String
  meta       Json?
  actorId    String?
  actorEmail String?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([entity])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

/**
 * Real, unfabricated search-demand log — every header-search query and every
 * suggestion click. Powers the admin "top queries" / "no-result queries"
 * insight; never fed back into ranking (see rank.ts, which stays pure
 * popularity + relevance, not click data).
 */
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  kind        String // "search" | "click"
  resultCount Int? // set for kind="search"; null for "click"
  productSlug String? // set for kind="click"
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([kind])
  @@index([createdAt])
}

enum ProductBadge {
  HIT
  NEW
  IN_STOCK
}

enum AttributeType {
  STRING
  NUMBER
  BOOLEAN
}

enum DocumentKind {
  CERTIFICATE
  DATASHEET
  MANUAL
  DRAWING
}

enum PriceKind {
  BASE
  WHOLESALE
  PROMO
}

model Category {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  description        String?
  spec               String?
  icon               String?
  /**
   * Optional photo URL — shown instead of/alongside the icon badge on the homepage category grid.
   */
  image              String?
  order              Int                 @default(0)
  products           Product[]
  attributeTemplates CategoryAttribute[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([order])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  origin    String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  sku         String        @unique
  title       String
  description String?       @db.Text
  unit        String        @default("шт")
  packaging   String?
  warranty    String?
  leadTime    String?
  badge       ProductBadge?
  popularity  Int           @default(0)
  published   Boolean       @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  images        ProductImage[]
  documents     ProductDocument[]
  values        AttributeValue[]
  stock         Stock[]
  prices        Price[]
  reviews       Review[]
  companyPrices CompanyPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([popularity])
  @@index([createdAt])
  // Composite indexes for the catalog's hot paths: published lists filtered by
  // category/brand and ordered by popularity or recency. Cover ~100k rows.
  @@index([published, categoryId, popularity])
  @@index([published, brandId, popularity])
  @@index([published, popularity])
  @@index([published, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String?
  alt       String?
  order     Int     @default(0)

  @@index([productId])
}

model ProductDocument {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  kind      DocumentKind
  url       String
  size      String?
  order     Int          @default(0)

  @@index([productId])
}

model Attribute {
  id                String              @id @default(cuid())
  key               String              @unique
  name              String
  type              AttributeType       @default(STRING)
  unit              String?
  filterable        Boolean             @default(true)
  order             Int                 @default(0)
  values            AttributeValue[]
  categoryTemplates CategoryAttribute[]

  @@index([order])
}

/**
 * Per-category "which characteristics matter" template — drives required/suggested spec hints on the product form.
 */
model CategoryAttribute {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  required    Boolean   @default(false)
  order       Int       @default(0)

  @@unique([categoryId, attributeId])
  @@index([categoryId])
}

model AttributeValue {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  valueString String?
  valueNumber Float?
  valueBool   Boolean?

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@index([attributeId, valueNumber])
  @@index([attributeId, valueString])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String
  stock     Stock[]
  createdAt DateTime @default(now())
}

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  restockAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model Price {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      PriceKind @default(BASE)
  amount    Int?
  currency  String    @default("KZT")
  minQty    Float     @default(1)
  validFrom DateTime  @default(now())
  validTo   DateTime?

  @@unique([productId, kind])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  company   String?
  rating    Int
  text      String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
}

/**
 * Broadcast staff notification (small back office — no per-user read state yet).
 */
model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model Quote {
  id            String      @id @default(cuid())
  /**
   * Optional project/object name the client gave their cart, e.g. "Электроснабжение объекта №1".
   */
  title         String?
  company       String
  name          String
  phone         String
  email         String?
  message       String      @db.Text
  status        QuoteStatus @default(NEW)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  deal          Deal?
  items         QuoteItem[]
  /**
   * Unguessable public link token — lets a customer open, approve, or
   * reject this quote at /kp/[token] without registering (Phase 15).
   * Set on every quote at creation so a link is always ready to share.
   */
  approvalToken String?     @unique
  respondedAt   DateTime?
  responseNote  String?
  order         Order?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Orders (Phase 16-18) — created from an approved (WON) Quote by staff.
// Quote/Customer/User links are copied from the source quote where it has
// them; Company/Project links stay null unless genuinely known (Quote has
// no DB relation to either) — not guessed, to avoid a false company/project
// association on an order.
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum OrderDocumentKind {
  INVOICE
  CONTRACT
  ACT
  SPECIFICATION
  WAYBILL
  OTHER
}

model Order {
  id                String          @id @default(cuid())
  /**
   * Human-readable order number shown to staff/customer, e.g. "ORD-260822-A1B2".
   */
  number            String          @unique
  status            OrderStatus     @default(NEW)
  quoteId           String?         @unique
  quote             Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id])
  companyId         String?
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?           @relation("OrderOwner", fields: [userId], references: [id])
  managerId         String?
  manager           User?           @relation("OrderManager", fields: [managerId], references: [id])
  carrier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  /**
   * Snapshot of the total at order creation, in тиын.
   */
  totalTiyn         Int?
  notes             String?         @db.Text
  items             OrderItem[]
  documents         OrderDocument[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
}

/**
 * One order line — snapshot, like QuoteItem/ProjectItem (productId/slug are not FKs).
 */
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  slug       String?
  sku        String?
  title      String
  qty        Float   @default(1)
  unit       String  @default("шт")
  amountTiyn Int?
  position   Int     @default(0)

  @@index([orderId])
}

/**
 * Invoice/contract/act/specification/waybill files — uploaded to Vercel Blob, same as product documents.
 */
model OrderDocument {
  id       String            @id @default(cuid())
  orderId  String
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title    String
  kind     OrderDocumentKind
  url      String
  size     String?
  position Int               @default(0)

  @@index([orderId])
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String?
  sku        String?
  title      String
  qty        Float   @default(1)
  unit       String  @default("шт")
  /**
   * Catalog price at the moment the item was added to the cart, in тиын (see Price.amount). Null if the product had no price ("по запросу").
   */
  amountTiyn Int?
  note       String?

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

/**
 * Company-level CRM record. Aggregates quotes, deals and activity history.
 */
model Customer {
  id         String         @id @default(cuid())
  company    String
  contact    String?
  phone      String?
  email      String?
  city       String?
  bin        String? // БИН/ИИН для юрлиц
  notes      String?        @db.Text
  status     CustomerStatus @default(LEAD)
  /**
   * Optional link to a portal account (личный кабинет).
   */
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  deals      Deal[]
  quotes     Quote[]
  orders     Order[]
  activities Activity[]
  ownerId    String? // ответственный менеджер
  owner      User?          @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([company])
  @@index([ownerId])
}

/**
 * A pipeline opportunity. May originate from a Quote.
 */
model Deal {
  id          String     @id @default(cuid())
  title       String
  stage       DealStage  @default(NEW)
  /**
   * Оценочная сумма сделки в тиынах (₸ ×100).
   */
  amount      Int?
  currency    String     @default("KZT")
  probability Int        @default(0) // 0..100
  expectedAt  DateTime?
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quoteId     String?    @unique
  quote       Quote?     @relation(fields: [quoteId], references: [id])
  ownerId     String?
  owner       User?      @relation("DealOwner", fields: [ownerId], references: [id])
  activities  Activity[]
  lostReason  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([stage])
  @@index([customerId])
  @@index([ownerId])
  @@index([createdAt])
}

/**
 * Timeline entry: note, call, email, meeting or task, attached to a customer/deal.
 */
model Activity {
  id         String       @id @default(cuid())
  type       ActivityType @default(NOTE)
  subject    String
  body       String?      @db.Text
  /**
   * For TASK: due date and completion flag.
   */
  dueAt      DateTime?
  done       Boolean      @default(false)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?        @relation(fields: [authorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([customerId])
  @@index([dealId])
  @@index([type])
  @@index([dueAt])
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String          @unique
  emailVerified      DateTime?
  passwordHash       String?
  role               UserRole        @default(CUSTOMER)
  company            String?
  phone              String?
  accounts           Account[]
  sessions           Session[]
  quotes             Quote[]
  customerProfile    Customer[]
  ownedCustomers     Customer[]      @relation("CustomerOwner")
  ownedDeals         Deal[]          @relation("DealOwner")
  activities         Activity[]
  companyMemberships CompanyMember[]
  ownedProjects      Project[]       @relation("ProjectOwner")
  managedProjects    Project[]       @relation("ProjectManager")
  ownedOrders        Order[]         @relation("OrderOwner")
  managedOrders      Order[]         @relation("OrderManager")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// B2B company accounts
// ---------------------------------------------------------------------------

enum CompanyRole {
  COMPANY_ADMIN
  PROCUREMENT
  ENGINEER
  VIEWER
}

/**
 * A B2B customer organization — the structured counterpart to the free-text
 * `company` labels on User/Quote/Customer (those stay as-is; this is an
 * opt-in layer for companies that want real requisites and multiple portal
 * users). Deliberately its own table with no new column on User, so it adds
 * zero risk to any existing unguarded `prisma.user.*` query.
 */
model Company {
  id            String          @id @default(cuid())
  name          String
  bin           String?         @unique
  legalAddress  String?
  actualAddress String?
  phone         String?
  email         String?
  notes         String?         @db.Text
  members       CompanyMember[]
  projects      Project[]
  orders        Order[]
  prices        CompanyPrice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([name])
}

/**
 * A per-company reference price for a product — staff sets this once, then it
 * surfaces as a suggested (never auto-applied) starting value when pricing a
 * quote line for a customer confirmed to belong to this company. Resolving
 * "this quote's company" only ever goes through the real Quote.userId →
 * CompanyMember relation (see admin/quotes/page.tsx) — never guessed from the
 * quote's free-text `company` label, for the same reason Quote itself has no
 * direct company relation (see the comment on Quote below).
 */
model CompanyPrice {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountTiyn Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, productId])
  @@index([companyId])
  @@index([productId])
}

/**
 * One user's membership in a company, with the B2B role that gates what
 * they can do there (Phase 4 of the roadmap: Company Admin manages
 * employees, Procurement requests quotes, Engineer creates projects,
 * Viewer is read-only). Checked server-side wherever it matters — never
 * trust the client for this.
 */
model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(VIEWER)
  createdAt DateTime    @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Project workspace (B2B specification/BOM) — saved from the existing
// client-side cart ("В проект" / "Проект пуст" — see CartProvider), which
// stays as the fast add-to-cart flow. This is the persisted, named,
// company-shareable upgrade: history, status, multiple projects at once.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  ANALYSIS
  QUOTATION
  APPROVAL
  ORDER
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  objectName  String?
  region      String?
  status      ProjectStatus @default(DRAFT)
  deadline    DateTime?
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id])
  items       ProjectItem[]
  orders      Order[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([status])
}

/**
 * One BOM line. `productId` is a soft snapshot reference (no FK, like
 * QuoteItem.productId) — the product may later be unpublished or removed
 * without breaking the project's history of what was specified.
 */
model ProjectItem {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId  String?
  /**
   * Snapshot for linking back to the product page — like productId, not a FK (see CartItem).
   */
  slug       String?
  sku        String?
  title      String
  qty        Float    @default(1)
  unit       String   @default("шт")
  amountTiyn Int?
  note       String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
