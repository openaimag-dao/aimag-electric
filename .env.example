# PostgreSQL connection string (Neon or similar). Required.
DATABASE_URL=

# NextAuth JWT signing secret. Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app. Required in production.
NEXTAUTH_URL=

# Canonical site origin for sitemap.xml, robots.txt, JSON-LD, and Open
# Graph/canonical URLs. Optional — defaults to the Vercel production URL.
# Set to the real domain once one is connected (e.g. https://aimag-electric.kz).
SITE_URL=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Get one
# at analytics.google.com. Unset = GA4 script never loads, no data sent.
NEXT_PUBLIC_GA_ID=

# Optional: Яндекс.Метрика counter id (a number). Get one at
# metrika.yandex.ru. Unset = Metrika script never loads, no data sent.
NEXT_PUBLIC_YM_ID=

# Optional: Google Search Console site-ownership verification token (HTML
# tag method — just the content value, not the whole <meta> tag). Get it
# when adding the domain at search.google.com/search-console.
GOOGLE_SITE_VERIFICATION=

# Optional: Яндекс.Вебмастер site-ownership verification token (meta tag
# method). Get it when adding the domain at webmaster.yandex.ru.
YANDEX_VERIFICATION=

# Optional: debug | info | warn | error (default: info in production).
LOG_LEVEL=

# Optional: enables the Telegram notification channel for new quotes.
# Get a token from @BotFather, message the bot once, then read the chat id
# from https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
